# ---- Secrets: never commit these ----
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties
.env
.env.*
!.env.example

# ---- Rust ----
/target/
**/target/
**/*.rs.bk

# ---- Qt / C++ build output ----
build/
build-*/
*.qmlc
*.jsc
.qmlls.ini
CMakeLists.txt.user*
*.pro.user*
compile_commands.json

# ---- Android / Gradle ----
.gradle/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
android/**/jniLibs/

# ---- IDEs and editors ----
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ---- OS clutter ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs and tool output ----
__pycache__/
*.py[cod]
*.log
aqtinstall.log

# Kotlin compiler session data
.kotlin/

# Nix build outputs
result
result-*

# ---- Sa6i Link local staging (connector downloads) ----
google_drive/

# ---- Sa6i Clean delivery staging (rebuilt by sa6i/clean/delivery/build_delivery.py) ----
sa6i/clean/delivery/app.asar
sa6i/clean/delivery/*.zip

# Rasterised brand art, reproducible in seconds:
#   python3 tools/brand/mark_rgba.py --dest assets/brand/mark-rgba
# The sizes the app embeds (desktop/app/assets/mark) are committed, because
# build.rs compiles them into the executable.
/assets/brand/mark-rgba/
